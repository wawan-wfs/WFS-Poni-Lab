{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poni Rebuild",
  "version": "0.1.0",
  "identifier": "id.wfs.ponirebuild",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Poni Rebuild", "width": 200, "height": 32, "resizable": false, "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico"] }
}
